{
  "$defs": {
    "ReviewAttestation": {
      "additionalProperties": false,
      "properties": {
        "manifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifestsha256",
          "type": "string"
        },
        "moduleId": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Moduleid",
          "type": "string"
        },
        "reviewedAt": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Reviewedat",
          "type": "string"
        },
        "scope": {
          "const": "backend-code",
          "title": "Scope",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "moduleId",
        "version",
        "sha256",
        "manifestSha256",
        "scope",
        "reviewedAt"
      ],
      "title": "ReviewAttestation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed list of reviewed backend versions (``reviews-v1.json``).",
  "properties": {
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/ReviewAttestation"
      },
      "maxItems": 20000,
      "title": "Reviews",
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "reviews"
  ],
  "title": "ReviewIndex",
  "type": "object"
}
